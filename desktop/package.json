{
  "name": "bibliotheque-kis",
  "productName": "Kivutheque",
  "version": "1.2.0",
  "description": "Kivuthèque — gestion de la bibliothèque et des fournitures de Kivu International School",
  "author": "Alexandre Declaire",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "python3 ../app/build.py",
    "start": "electron .",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "school.kivu.kivutheque",
    "productName": "Kivutheque",
    "copyright": "Kivu International School — Made by Alexandre et Declaire",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "artifactName": "Kivutheque-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "CFBundleDisplayName": "Kivuthèque",
        "NSCameraUsageDescription": "Kivuthèque utilise la caméra pour scanner le code-barres ISBN des livres."
      }
    },
    "dmg": {
      "title": "Kivuthèque",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kivuthèque",
      "language": "1036",
      "uninstallDisplayName": "Kivuthèque"
    },
    "portable": {
      "artifactName": "Kivutheque-${version}-windows-portable.${ext}"
    },
    "publish": null,
    "afterPack": "build/adhoc-sign.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandretshimpaka062-afk/Alex"
  }
}